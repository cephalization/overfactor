{
  "name": "@overfactor/integration-pi",
  "version": "0.0.0",
  "description": "Pi extension integration for Overfactor lifecycle and session events.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./install": "./dist/install.mjs",
    "./package.json": "./package.json",
    "./transcript": "./dist/transcript.mjs"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@overfactor/sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
